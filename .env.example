# Copiar para .env.local (fora do git) e preencher. Nunca pôr chaves no código.

# URL público da app — usado nos QR Codes. Em produção: https://app.example.com
NEXT_PUBLIC_APP_URL=

# Segredo para assinar o cookie de sessão (HMAC). Obrigatório em produção, mínimo 32 caracteres.
# Gerar com: openssl rand -base64 48
SESSION_SECRET=

# Supabase (quando o projeto for criado). Sem estas variáveis a app corre em modo demonstração.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no servidor (convites de utilizadores, tarefas de administração). Nunca expor no browser.
SUPABASE_SERVICE_ROLE_KEY=

# Demonstração para a proposta: guia interativo, faixa "dados fictícios" e "Repor dados".
# Sempre ligada no site publicado (src/lib/demo.ts). Só em desenvolvimento se desliga:
# NEXT_PUBLIC_MODO_DEMO=0
